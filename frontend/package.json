{
  "name": "card-game-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:reducer": "cd .. && PYTHONPATH=. python3 scripts/dump_beats.py | node frontend/scripts/check-reducer.mjs",
    "build:app": "tsc && VITE_BUNDLED=1 vite build --outDir dist-app --emptyOutDir",
    "test:progress": "node scripts/check-progress.mjs",
    "test:campaign": "node scripts/check-campaign.mjs",
    "test:live": "node scripts/check-live.mjs",
    "test:music": "node scripts/check-music.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "pyodide": "0.27.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tonal": "^6.10.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
